# Normalise line endings in the repo; check out with the platform's native endings unless pinned below.
* text=auto

# Windows-native files keep CRLF so PowerShell 5.1, cmd and Visual Studio read them unchanged.
*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.psd1     text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.sln      text eol=crlf
*.slnx     text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf

# Everything else that is text is LF so hashes, golden vectors and Node tooling agree across machines.
*.cs       text eol=lf
*.mjs      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.sh       text eol=lf

# Binary content is never diffed or normalised.
*.png      binary
*.jpg      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.nupkg    binary
*.snupkg   binary
*.tgz      binary
*.pfx      binary
*.xlsx     binary
*.docx     binary
