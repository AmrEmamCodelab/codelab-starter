{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "Codelab": {
    "Security": {
      "Protocol": { "Prefix": "STARTER" },
      "RequestSigning": { "Mode": "Off" },
      "ResponseSigning": { "Mode": "Off" },
      "ReplayProtection": { "Store": "Memory", "AcknowledgeSingleInstance": true },
      "ServiceAssertions": {
        "Client": { "ServiceName": "starter-ops-console", "Audience": "starter-api" }
      }
    },
    "OpsConsole": {
      "ServiceName": "starter-ops-console",
      "OperatorGroup": "",
      "Api": { "BaseUrl": "", "TimeoutSeconds": 15 },
      "Seq": { "BaseUrl": "", "TimeoutSeconds": 15, "MaxEvents": 200, "LookbackDays": 31 },
      "DevOperator": { "Enabled": false }
    }
  },
  "AllowedHosts": "*"
}
