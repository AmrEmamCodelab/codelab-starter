<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS template for the Ops Console API (ASP.NET Core Module V2, in-process), a child application under the existing
  site. No secrets here: the service key and the Seq read key come from the app pool environment or a secret store
  (see services/ops-console/MODULE.md).
  - forwardWindowsAuthToken: the Negotiate handler forwards to IIS Windows authentication. The authentication
    sections (windowsAuthentication on, anonymousAuthentication off) are locked at the server level by default, so the
    install kit sets them for this application with appcmd/Set-WebConfigurationProperty, never in this file.
  - Read-only API: only GET reaches the app.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="GET,HEAD" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Codelab.OpsConsole.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" forwardWindowsAuthToken="true" />
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
