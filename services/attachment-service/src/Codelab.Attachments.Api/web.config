<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS template for the attachment service (ASP.NET Core Module V2, in-process). No secrets here: key material comes
  from the app pool environment or a secret store (see services/attachment-service/MODULE.md).
  - WebDAVModule is removed, or IIS answers DELETE /api/files/{fileId} itself with 405.
  - maxAllowedContentLength is the IIS request ceiling: keep it at least the upload body ceiling
    (Codelab:Security:Uploads:MaxTotalBytes plus the multipart framing allowance; 52609024 for the shipped defaults).
    ConfigurationFilesTests fails when it falls below.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Codelab.Attachments.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="52609024" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
