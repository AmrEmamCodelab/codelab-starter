{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "Codelab": {
    "Security": {
      "Protocol": { "Prefix": "STARTER" },
      "RequestSigning": { "Mode": "Off" },
      "ResponseSigning": { "Mode": "Off" },
      "ReplayProtection": { "Store": "Memory", "AcknowledgeSingleInstance": true },
      "Tickets": { "Enabled": true },
      "Uploads": {
        "ReceiptsEnabled": true,
        "MaxFileBytes": 10485760,
        "MaxFileCount": 10,
        "MaxTotalBytes": 52428800
      },
      "ServiceAssertions": {
        "Server": { "Audience": "starter-attachments" }
      }
    }
  },
  "Attachments": {
    "ServiceName": "starter-attachments",
    "Storage": {},
    "Cors": { "AllowedOrigins": [] }
  },
  "AllowedHosts": "*"
}
