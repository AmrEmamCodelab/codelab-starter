<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of Codelab.Attachments.Core: the file-share store and the streaming upload pipeline. Every test works in a
    temp folder it creates and deletes (TestSupport/TempStorageRoot); receipt keys are generated per run, never committed.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Codelab.Attachments.Core\Codelab.Attachments.Core.csproj" />
  </ItemGroup>
</Project>
