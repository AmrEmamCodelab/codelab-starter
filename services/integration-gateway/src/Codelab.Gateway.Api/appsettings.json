{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
    }
  },
  "Codelab": {
    "Security": {
      "Protocol": { "Prefix": "STARTER" },
      "RequestSigning": { "Mode": "Off" },
      "ResponseSigning": { "Mode": "Off" },
      "ReplayProtection": { "Store": "Memory", "AcknowledgeSingleInstance": true },
      "ServiceAssertions": {
        "Server": { "Audience": "integration-gateway", "MaxBodyBytes": 16384 }
      }
    },
    "Integration": {
      "Gateway": { "Profiles": [] }
    }
  },
  "Gateway": {
    "ServiceName": "starter-gateway",
    "Sso": {
      "JwksCacheDuration": "00:10:00",
      "Retry": { "MaxRetries": 2 },
      "Certificate": { "Mode": 1 }
    },
    "Sms": {
      "Method": 2,
      "BodyFormat": 1,
      "LanguageCodes": { "Arabic": "ar", "English": "en" },
      "Retry": { "MaxRetries": 0 },
      "Certificate": { "Mode": 1 }
    },
    "Readiness": { "ResolveUpstreamHosts": true, "ResolveTimeout": "00:00:02" }
  },
  "AllowedHosts": "*"
}
