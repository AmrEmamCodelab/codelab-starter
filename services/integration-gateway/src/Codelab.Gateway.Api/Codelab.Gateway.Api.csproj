<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Codelab.Gateway.Api: the integration gateway, a separate deployable for the DMZ (IIS site or Kestrel). The backend
    has no egress, so it calls this host with an ES256 service assertion and the gateway relays to the upstream:
    the OIDC provider's token and JWKS endpoints (profile "sso") and the SMS provider (profile "sms"). Program.cs wires
    the Codelab packages (Observability, Errors, Security, Integration); see services/integration-gateway/MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Codelab.Gateway.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The rules engine emits the module files at the service root (services/integration-gateway/module.rules.yaml). -->
    <CodelabProjectBannedSymbolsFile>../../BannedSymbols.generated.txt</CodelabProjectBannedSymbolsFile>
    <CodelabProjectCodeMetricsFile>../../CodeMetricsConfig.txt</CodelabProjectCodeMetricsFile>
  </PropertyGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Observability" />
    <CodelabPackageReference Include="Codelab.Errors" />
    <CodelabPackageReference Include="Codelab.Integration" />
  </ItemGroup>

  <!--
    The gitignored per-machine secrets (appsettings.*.local.json: the trusted caller keys, the SMS provider
    credential) must never reach a publish folder, a zip or a handover kit.
  -->
  <ItemGroup>
    <Content Update="appsettings.*.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codelab.Gateway.Api.Tests" />
  </ItemGroup>
</Project>
