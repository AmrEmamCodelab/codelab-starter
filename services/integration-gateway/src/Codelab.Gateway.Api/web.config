<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS template for the integration gateway (ASP.NET Core Module V2, in-process), a DMZ site of its own. No secrets
  here: the trusted caller keys and the SMS provider credential come from the app pool environment or a secret store
  (see services/integration-gateway/MODULE.md and docs/runbooks/gateway.md).
  - maxAllowedContentLength is the IIS request ceiling: it equals the gateway's relay ceiling
    (GatewayHostSettings.MaxRequestBodyBytes, 16384) and Codelab:Security:ServiceAssertions:Server:MaxBodyBytes.
    ConfigurationFilesTests fails when they differ.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Codelab.Gateway.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="16384" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
