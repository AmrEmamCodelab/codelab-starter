}

/// <summary>Creates one {{Module}} record (<c>{{HttpRoute}}</c>). The permission is enforced by the endpoint.</summary>
public sealed class {{Name}}(IValidator<{{Name}}Command> validator, I{{Name}}Store store)
{
    /// <summary>
    /// The new record's id; a 400 refusal with every field error when the command is invalid; a 422 refusal
    /// (<see cref="{{Module}}ErrorCodes.{{ErrorConst}}"/>) when the store refuses it.
    /// </summary>
    public async Task<Outcome<{{Name}}Result>> ExecuteAsync({{Name}}Command command, CancellationToken cancellationToken)
    {
        var errors = validator.Validate(command);
        if (!errors.IsValid)
        {
            return Refusal.Invalid(errors);
        }

        var id = await store.CreateAsync(command, cancellationToken);
        if (id is not { } created)
        {
            return Refusal.Unprocessable({{Module}}ErrorCodes.{{ErrorConst}});
        }

        return new {{Name}}Result(created);
    }
}
