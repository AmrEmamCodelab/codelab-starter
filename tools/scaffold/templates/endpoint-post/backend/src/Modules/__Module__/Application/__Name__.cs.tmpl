using Starter.Application.Results;
using Starter.Application.Validation;
using Starter.Modules.{{Module}}.Domain;

namespace Starter.Modules.{{Module}}.Application;

/// <summary>The request body of <c>{{HttpRoute}}</c>, validated by <see cref="{{Name}}Validator"/>.</summary>
/// <param name="Name">The new record's display name.</param>
public sealed record {{Name}}Command(string Name);

/// <summary>What <see cref="{{Name}}"/> returns.</summary>
/// <param name="Id">The new record's internal id.</param>
public sealed record {{Name}}Result(long Id);

/// <summary>Validates <see cref="{{Name}}Command"/>: every field error at once, never throws.</summary>
public sealed class {{Name}}Validator : IValidator<{{Name}}Command>
{
    /// <inheritdoc />
    public ValidationErrors Validate({{Name}}Command input)
    {
        ArgumentNullException.ThrowIfNull(input);
        return new ValidationErrors().RequireText(
            field: FieldNames.Of(nameof({{Name}}Command.Name)),
            value: input.Name,
            maxLength: {{Module}}Limits.NameMaxLength);
    }
}

/// <summary>The data port of <see cref="{{Name}}"/>, implemented in Infrastructure.</summary>
public interface I{{Name}}Store
{
    /// <summary>Stores the new record and returns its id, or null when the store refuses it.</summary>
