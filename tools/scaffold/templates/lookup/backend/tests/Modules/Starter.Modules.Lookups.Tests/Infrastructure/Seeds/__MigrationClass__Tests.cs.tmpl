using System.Reflection;
using Starter.Domain.Lookups;
using Starter.Modules.Lookups.Domain;
using Starter.Modules.Lookups.Infrastructure.Persistence.Migrations;

namespace Starter.Modules.Lookups.Tests.Infrastructure.Seeds;

/// <summary>
/// The <see cref="LookupTypes.{{TypeConst}}"/> seed (<see cref="{{MigrationClass}}"/>) against its ids constants
/// (<see cref="{{IdsClass}}"/>), generated by tools/scaffold/new-lookup.mjs. Every seed migration is also checked by
/// SeedMigrationTests (unique ids and codes, an Arabic and an English name). A later migration that adds values adds
/// its own rows here.
/// </summary>
public sealed class {{MigrationClass}}Tests
{
    private const string ItemsField = "Items";

    private static IReadOnlyList<LookupItemSeed> Items =>
        (IReadOnlyList<LookupItemSeed>)typeof({{MigrationClass}}).GetField(ItemsField, BindingFlags.NonPublic | BindingFlags.Static)!.GetValue(null)!;

    [Fact]
    public void The_seed_writes_exactly_the_{{IdsClass}}_values()
    {
        var constants = typeof({{IdsClass}}).GetFields()
            .Where(field => field.IsLiteral)
            .Select(field => (int)field.GetRawConstantValue()!);

        Assert.Equal(constants.Order(), Items.Select(item => item.Id).Order());
    }

    [Theory]
{{CodeCases}}
    public void Each_code_keeps_its_id(string code, int id) =>
        Assert.Equal(id, Items.Single(item => item.Code == code).Id);

    [Fact]
    public void The_type_key_is_stable() =>
        Assert.Equal("{{TypeKey}}", LookupTypes.{{TypeConst}});
}
