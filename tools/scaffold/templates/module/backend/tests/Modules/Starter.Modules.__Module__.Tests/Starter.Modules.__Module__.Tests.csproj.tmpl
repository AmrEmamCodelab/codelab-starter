<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the {{Module}} module, created by tools/scaffold/new-module.mjs: the module surface, and one test
    class per use case (tools/scaffold/new-endpoint.mjs adds them). Fakes stand behind the module's ports; no database.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\{{Module}}\Starter.Modules.{{Module}}.csproj" />
  </ItemGroup>
</Project>
