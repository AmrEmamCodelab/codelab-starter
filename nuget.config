<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Two sources only. The local folder feed holds Codelab.* packages produced by tools/build.ps1 -Pack
    (a hosted feed replaces it when the repo moves to a server; only this file changes).
    Package source mapping: Codelab.* resolves ONLY from the Codelab feed (no dependency-confusion via nuget.org);
    everything else resolves from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="codelab-local" value="feed/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="codelab-local">
      <package pattern="Codelab.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
