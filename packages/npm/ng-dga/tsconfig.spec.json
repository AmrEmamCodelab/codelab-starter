{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".angular/spec",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "angularCompilerOptions": {
    "compilationMode": "full"
  },
  "include": ["src/**/*.ts"]
}
