{
  "name": "@codelab/ng-security",
  "version": "0.0.0",
  "description": "Codelab Angular security client: canonical framing, request signing and response verification interceptors, session signing keys, WireId branded types and the problem+json error parser.",
  "license": "UNLICENSED",
  "author": "Codelab",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "MODULE.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "rxjs": "^7.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
