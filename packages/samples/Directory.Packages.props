<Project>
  <!--
    Central package versions of the package integration test. Independent of the repo-root Directory.Packages.props
    on purpose (a fork owns its own pins); the third-party versions match the repo's so the closure stays small.
    Codelab.* versions come from Codelab.Versions.props.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Codelab packages (feed only)">
    <PackageVersion Include="Codelab.Security" Version="$(CodelabSecurityVersion)" />
    <PackageVersion Include="Codelab.Observability" Version="$(CodelabObservabilityVersion)" />
    <PackageVersion Include="Codelab.Errors" Version="$(CodelabErrorsVersion)" />
    <PackageVersion Include="Codelab.Integration" Version="$(CodelabIntegrationVersion)" />
    <PackageVersion Include="Codelab.Testing" Version="$(CodelabTestingVersion)" />
  </ItemGroup>

  <ItemGroup Label="Analyzers (wired by Codelab.Build.Sdk)">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Host and tests">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
</Project>
