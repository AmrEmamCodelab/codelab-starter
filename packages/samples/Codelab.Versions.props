<Project>
  <!--
    The Codelab package versions the sample is tested against: the ONE place a fork pins them. tools/build.ps1 step 13
    reads this file. When a pinned version is missing from feed\ (a fresh clone), step 13 packs a ci prerelease into a
    temporary feed and overrides every property below on the command line (-p:CodelabSecurityVersion=0.5.0-ci.<n> ...).
    The property name is the package id without dots, plus "Version".
    Security 0.6.0, Observability 0.5.2, Errors 0.5.2, Testing 0.6.0, Integration 0.6.0 and Identity 0.6.0 are the
    versions.json versions that are not released yet: until
    they are in feed\, step 13 tests the sample against a ci prerelease of the current sources (the gateway contracts
    included), never against an older release.
  -->
  <PropertyGroup>
    <CodelabBuildSdkVersion Condition="'$(CodelabBuildSdkVersion)' == ''">0.2.1</CodelabBuildSdkVersion>
    <CodelabSecurityVersion Condition="'$(CodelabSecurityVersion)' == ''">0.6.0</CodelabSecurityVersion>
    <CodelabObservabilityVersion Condition="'$(CodelabObservabilityVersion)' == ''">0.5.2</CodelabObservabilityVersion>
    <CodelabErrorsVersion Condition="'$(CodelabErrorsVersion)' == ''">0.5.2</CodelabErrorsVersion>
    <CodelabTestingVersion Condition="'$(CodelabTestingVersion)' == ''">0.6.0</CodelabTestingVersion>
    <CodelabIntegrationVersion Condition="'$(CodelabIntegrationVersion)' == ''">0.6.0</CodelabIntegrationVersion>
    <CodelabIdentityVersion Condition="'$(CodelabIdentityVersion)' == ''">0.6.0</CodelabIdentityVersion>
  </PropertyGroup>
</Project>
