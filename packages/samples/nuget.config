<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The package integration test restores Codelab.* ONLY from the local feed, exactly as a fork does (ADR-002 feed
    mode). The sample has no source path to packages/dotnet: there is no ProjectReference to a Codelab project
    (FeedOnlyBoundaryTests and tools/build.ps1 step 13 refuse one). Third-party packages come from nuget.org.
    The source keys match the repo-root nuget.config, so the merged package source mapping stays unambiguous.
  -->
  <packageSources>
    <clear />
    <add key="codelab-local" value="../../feed/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="codelab-local">
      <package pattern="Codelab.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
