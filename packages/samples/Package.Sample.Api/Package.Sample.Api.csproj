<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The package integration test host: wires the Codelab packages in a few lines (Program.cs). Restored from the feed
    only; never a ProjectReference to packages/dotnet (see ../README.md).
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Package.Sample.Api</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Codelab.Security" />
    <PackageReference Include="Codelab.Observability" />
    <PackageReference Include="Codelab.Errors" />
    <PackageReference Include="Codelab.Integration" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
</Project>
