{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "Codelab": {
    "Security": {
      "Protocol": { "Prefix": "PKGSAMPLE" },
      "RequestSigning": {
        "Mode": "Enforce",
        "Audience": "package-sample",
        "MaxAgeSeconds": 120
      },
      "ResponseSigning": { "Mode": "Enforce" },
      "ReplayProtection": {
        "Store": "Memory",
        "AcknowledgeSingleInstance": true
      },
      "ServiceAssertions": {
        "Server": { "Audience": "package-sample" }
      }
    }
  },
  "Sample": {
    "Authentication": {
      "Issuer": "package-sample",
      "Audience": "package-sample",
      "SessionLifetimeMinutes": 30
    },
    "Archive": {
      "BaseAddress": "https://archive.example.test/",
      "Retry": { "MaxRetries": 0 }
    }
  },
  "AllowedHosts": "*"
}
