<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Codelab.Integration, plus TLS tests against an in-process Kestrel server whose certificates are
    generated at run time (no key material in the repo): an untrusted self-signed server is refused, a pinned CA and
    a pinned leaf are accepted, and no always-true certificate validator exists in the package source.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codelab.Integration\Codelab.Integration.csproj" />
  </ItemGroup>
</Project>
