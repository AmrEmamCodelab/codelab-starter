<Project>
  <!--
    Codelab.Build.Sdk - targets (imported AFTER the project body, so project settings are visible here).
  -->

  <!-- Banned APIs: one global list shipped in this package + an optional per-project list emitted by tools/rules-engine. -->
  <ItemGroup Condition="'$(CodelabEnableBannedApis)' == 'true'">
    <AdditionalFiles Include="$(CodelabBuildSdkDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\$(CodelabProjectBannedSymbolsFile)"
                     Condition="Exists('$(MSBuildProjectDirectory)\$(CodelabProjectBannedSymbolsFile)')" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    Codelab clean-code analyzers (CLB1001-CLB1004). Feed mode: the dll ships inside this package at
    analyzers/dotnet/cs, next to the Sdk folder. Source mode (the starter monorepo, no packaged dll beside Sdk/): the
    analyzer project is referenced as an Analyzer, so a change to it needs no publish. The analyzer project never
    references itself.
  -->
  <PropertyGroup>
    <CodelabBuildAnalyzersAssembly>$([MSBuild]::NormalizePath('$(CodelabBuildSdkDirectory)', '..', 'analyzers', 'dotnet', 'cs', 'Codelab.Build.Analyzers.dll'))</CodelabBuildAnalyzersAssembly>
    <CodelabBuildAnalyzersProject Condition="'$(CodelabBuildAnalyzersProject)' == ''">$([MSBuild]::NormalizePath('$(CodelabBuildSdkDirectory)', '..', '..', 'Codelab.Build.Analyzers', 'Codelab.Build.Analyzers.csproj'))</CodelabBuildAnalyzersProject>
    <CodelabBuildAnalyzersFromPackage>false</CodelabBuildAnalyzersFromPackage>
    <CodelabBuildAnalyzersFromPackage Condition="Exists('$(CodelabBuildAnalyzersAssembly)')">true</CodelabBuildAnalyzersFromPackage>
    <CodelabBuildAnalyzersFromSource>false</CodelabBuildAnalyzersFromSource>
    <CodelabBuildAnalyzersFromSource Condition="'$(CodelabBuildAnalyzersFromPackage)' != 'true' and Exists('$(CodelabBuildAnalyzersProject)') and '$(MSBuildProjectFullPath)' != '$(CodelabBuildAnalyzersProject)'">true</CodelabBuildAnalyzersFromSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(CodelabEnableBuildAnalyzers)' == 'true'">
    <Analyzer Include="$(CodelabBuildAnalyzersAssembly)" Condition="'$(CodelabBuildAnalyzersFromPackage)' == 'true'" />
    <ProjectReference Include="$(CodelabBuildAnalyzersProject)" Condition="'$(CodelabBuildAnalyzersFromSource)' == 'true'"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0" SkipGetTargetFrameworkProperties="true" />
    <GlobalAnalyzerConfigFiles Include="$(CodelabRulesGlobalConfig)"
                               Condition="'$(CodelabRulesGlobalConfig)' != '' and Exists('$(CodelabRulesGlobalConfig)')" />
    <!-- Lets CLB1004 skip test projects (codelab_exclude_tests): a project NAMED *.Tests, never IsTestProject alone. -->
    <CompilerVisibleProperty Include="MSBuildProjectName" />
  </ItemGroup>

  <!-- Code-metrics thresholds (CA1502) emitted per module by tools/rules-engine. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\$(CodelabProjectCodeMetricsFile)"
                     Condition="Exists('$(MSBuildProjectDirectory)\$(CodelabProjectCodeMetricsFile)')" />
  </ItemGroup>

  <!--
    Public packages (set <CodelabPackage>true</CodelabPackage> in the project): the public surface is tracked in
    PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, and NuGet package validation compares against the last
    released version (<CodelabPackageBaselineVersion>), so a breaking change fails the pack.
  -->
  <ItemGroup Condition="'$(CodelabPackage)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt"
                     Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt"
                     Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CodelabPackage)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == ''">$(CodelabPackageBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Without CPM the analyzer versions come from this SDK; with CPM, Directory.Packages.props owns them (NU1008 otherwise). -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="$(CodelabBannedApiAnalyzersVersion)" />
    <PackageReference Update="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="$(CodelabPublicApiAnalyzersVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CodelabRelease" Value="$(CodelabRelease)" />
  </ItemGroup>

  <!--
    The quality gates cannot be switched off from a project: every value other than 'true' (False, off, 0, ...) would
    otherwise remove the banned-API or CLB analyzers, and EnableNETAnalyzers=false or an AnalysisLevel/AnalysisMode of
    none would remove CA1502. Only the SDK's own fixture builds (Codelab.Build.Analyzers.Tests) pass
    CodelabFixtureGateOptOut=true on the command line; base.no-analyzer-opt-out refuses that name anywhere else.
  -->
  <Target Name="CodelabValidateQualityGates" BeforeTargets="BeforeBuild;CoreCompile">
    <Error Code="CODELAB002"
           Condition="'$(CodelabFixtureGateOptOut)' != 'true' and ('$(CodelabEnableBannedApis)' != 'true' or '$(CodelabEnableBuildAnalyzers)' != 'true')"
           Text="CodelabEnableBannedApis and CodelabEnableBuildAnalyzers must be 'true' (got '$(CodelabEnableBannedApis)' and '$(CodelabEnableBuildAnalyzers)'). Fix the code instead; a justified exception is a module.rules.yaml exemption." />
    <Error Code="CODELAB003"
           Condition="'$(EnableNETAnalyzers)' != 'true' or $(AnalysisLevel.ToLowerInvariant().Contains('none')) or $(AnalysisMode.ToLowerInvariant().Contains('none'))"
           Text="The .NET analyzers (CA1502 complexity and the CA rules) must stay on: EnableNETAnalyzers='$(EnableNETAnalyzers)', AnalysisLevel='$(AnalysisLevel)', AnalysisMode='$(AnalysisMode)'." />
  </Target>

  <Target Name="CodelabValidateRelease" BeforeTargets="BeforeBuild;GenerateNuspec">
    <Error Code="CODELAB001"
           Condition="'$(CodelabReleaseIsValid)' != 'true'"
           Text="CODELAB_RELEASE / CodelabRelease '$(CodelabRelease)' is not a semantic version (expected e.g. 1.4.0 or 1.4.0-rc.2)." />
  </Target>

  <!--
    The SDK's source-control integration sets the full 40-character sha; the release is <semver>+<short sha>.
    Runs after that integration and before the informational version is composed.
  -->
  <Target Name="CodelabShortenSourceRevisionId"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(SourceRevisionId)' != '' and $(SourceRevisionId.Length) &gt; $(CodelabSourceRevisionLength)">
    <PropertyGroup>
      <SourceRevisionId>$(SourceRevisionId.Substring(0, $(CodelabSourceRevisionLength)))</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
