<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Codelab.Integration 0.6: the outbound call engine (typed outbound clients, an options-driven retry and timeout
    policy on Microsoft.Extensions.Http.Resilience / Polly.Core, failure classification, server-certificate validation
    that is always on) plus the integration gateway contracts: relay routes and DTOs, problem codes, the gateway
    profile extension point and registry, and the typed GatewayRelayClient that signs every attempt with the
    Codelab.Security ES256 service assertion. See MODULE.md.

    Since 0.6 it references the ASP.NET Core shared framework (IGatewayProfile maps endpoints) and Codelab.Security
    (service assertions). The Microsoft.Extensions.* packages come from that framework (NU1510 forbids listing them).
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <PackageId>Codelab.Integration</PackageId>
    <RootNamespace>Codelab.Integration</RootNamespace>
    <CodelabPackage>true</CodelabPackage>
    <Authors>Codelab</Authors>
    <Company>Codelab</Company>
    <Description>Codelab outbound integration engine and integration gateway contracts: typed outbound HTTP clients with options-driven retry and timeout, outbound failure classification, a correlation handler slot, server-certificate validation that is always on, gateway relay routes, DTOs and problem codes, the gateway profile extension point, and a gateway relay client signed with the Codelab ES256 service assertion.</Description>
    <PackageTags>codelab;http;resilience;integration;gateway</PackageTags>
    <PackageReadmeFile>MODULE.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codelab.Security\Codelab.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codelab.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MODULE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
