{
  "$entity": "alert",
  "Title": "Ops: [{{env}}] CSP violations",
  "Description": "Runbook: docs/runbooks/seq.md, section 'CSP violations'.",
  "OwnerId": null,
  "IsProtected": true,
  "IsDisabled": false,
  "DataSource": "Stream",
  "Joins": [],
  "SignalExpression": {
    "Kind": "Signal",
    "SignalId": "{{ref:signal-csp-violations.template}}"
  },
  "Where": "DeploymentEnvironment = '{{env}}'",
  "GroupBy": [
    {
      "Value": "Application",
      "Label": null,
      "IsCaseInsensitive": false
    }
  ],
  "TimeGrouping": "01:00:00",
  "Select": [
    {
      "Value": "count(*)",
      "Label": "n"
    }
  ],
  "Having": "n > {{cspViolationsPerHour}}",
  "NotificationLevel": "Warning",
  "NotificationProperties": [],
  "NotificationChannels": "{{json:notificationChannels}}",
  "SuppressionTime": "06:00:00"
}
