{
  "$entity": "alert",
  "Title": "Ops: [{{env}}] Server errors (5xx)",
  "Description": "Runbook: docs/runbooks/seq.md, section 'Server errors'.",
  "OwnerId": null,
  "IsProtected": true,
  "IsDisabled": false,
  "DataSource": "Stream",
  "Joins": [],
  "SignalExpression": {
    "Kind": "Signal",
    "SignalId": "{{ref:signal-server-errors.template}}"
  },
  "Where": "DeploymentEnvironment = '{{env}}'",
  "GroupBy": [
    {
      "Value": "Application",
      "Label": null,
      "IsCaseInsensitive": false
    }
  ],
  "TimeGrouping": "00:05:00",
  "Select": [
    {
      "Value": "count(*)",
      "Label": "n"
    }
  ],
  "Having": "n > {{serverErrorsPerFiveMinutes}}",
  "NotificationLevel": "Error",
  "NotificationProperties": [],
  "NotificationChannels": "{{json:notificationChannels}}",
  "SuppressionTime": "01:00:00"
}
