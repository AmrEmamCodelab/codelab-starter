# Example nginx server block for the SPA front site (the IIS equivalent is deploy/kits/templates/web/web.config).
# Copy it to the nginx host, replace every <...> value there (never commit hosts, certificates or paths of a real
# environment), and keep the two includes. See deploy/nginx/README.md.

server {
    listen 443 ssl;
    http2 on;
    server_name <portal host name>;

    ssl_certificate     <path to the certificate chain>;
    ssl_certificate_key <path to the private key>;
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    root <folder holding index.html>;

    include <this folder>/security-headers.conf;
    include <this folder>/edge-blocks.conf;

    # The API under the same origin (connect-src 'self' and the relative CSP report path need it).
    location /api/ {
        proxy_pass https://<api upstream>;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Drop caller-supplied trace context (an empty value removes the header): the API starts its own trace.
        proxy_set_header traceparent "";
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
    }

    # Hashed bundles (<name>-<8 hash characters>.<ext>): a new build is a new URL, so cache for a year.
    location ~* "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|svg|png|jpe?g|gif|webp|ico)$" {
        include <this folder>/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Runtime settings and the stamped build id: always revalidated.
    location = /config.json {
        include <this folder>/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location = /build-info.json {
        include <this folder>/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Deep links serve index.html, never cached.
    location / {
        include <this folder>/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
