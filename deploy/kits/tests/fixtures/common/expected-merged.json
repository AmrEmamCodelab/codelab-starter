{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Starter": "set-on-server"
  },
  "Attachments": {
    "Storage": {
      "RootPath": "D:\\data\\attachments",
      "TempPath": ""
    },
    "Cors": {
      "AllowedOrigins": [
        "https://portal.example.test"
      ],
      "AllowCredentials": false
    }
  },
  "Branding": {
    "NameAr": "بوابة الخدمات",
    "NameEn": "Services portal \"v2\""
  },
  "Codelab": {
    "Security": {
      "Uploads": {
        "MaxFileBytes": 10485760,
        "AllowedExtensions": [
          ".pdf"
        ],
        "BlockedExtensions": [
          ".exe",
          ".js"
        ],
        "Receipts": {
          "Enabled": true,
          "LifetimeSeconds": 900
        }
      }
    }
  },
  "FeatureLimit": 2.50,
  "EmptySection": {
    "Added": null
  },
  "Legacy": "flat-value",
  "AllowedHosts": "*"
}
