<?xml version="1.0" encoding="utf-8"?>
<!--
  The SPA front site (starter-web) on IIS. Installed by deploy/kits/Install-Web.ps1, which merges this file into the
  server's web.config: an element the server already has (a header, a rule, a location) is kept as the server has it,
  and only elements new in this template are added. See deploy/kits/templates/web/README.md.

  Security header values come from security-headers.psd1 in this folder; deploy/nginx/security-headers.conf carries
  the same values, and deploy/kits/tests/SecurityHeaders.Parity.Tests.ps1 fails when the three drift apart. The
  same holds for the stripped inbound trace headers (the <location> elements at the end; deploy/nginx/trace-context.conf).
  Needs the IIS URL Rewrite module (rewrite rules below).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Edge block: the front site never serves /api/internal/* or /api/ops/*, also when /api is a child application
             of this site (the rule is inherited). The Ops Console API and the gateway reach those routes through the
             API's own binding. {UNENCODED_URL} catches an encoded slash. -->
        <rule name="Block internal and ops API" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{URL}" pattern="^/api/+(internal|ops)(/|$)" ignoreCase="true" />
            <add input="{UNENCODED_URL}" pattern="^/api/+(internal|ops)(/|%2f|$)" ignoreCase="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <!-- Deep links (/ar/requests/...) serve index.html. Child applications of this site (the API, the attachment
             service, the Ops Console screens and API) inherit this rule, so their paths are excluded; add a new child path here
             (Install-Ops refuses to install under a site whose fallback would rewrite its paths). -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{URL}" pattern="^/(api|attachments|ops|ops-api)(/|$)" ignoreCase="true" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <outboundRules>
        <preConditions>
          <!-- Angular's production build names bundles <name>-<8 hash characters>.<ext>: a new build is a new URL. -->
          <preCondition name="Hashed bundle">
            <add input="{REQUEST_URI}" pattern="-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|svg|png|jpe?g|gif|webp|ico)$" />
          </preCondition>
          <preCondition name="HTML document">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
        <rule name="Cache hashed bundles" preCondition="Hashed bundle">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <!-- index.html, also when served for a deep link by the SPA fallback: always revalidated, so a deploy is seen
             at the next navigation. -->
        <rule name="No-cache documents" preCondition="HTML document">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self' 'sha256-LMY6wYoFV9I4wWzxaq1N/dTpl4iurQktw706UCHK3vM='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/security/csp-reports; report-to csp-endpoint" />
        <add name="Reporting-Endpoints" value="csp-endpoint=&quot;/api/security/csp-reports&quot;" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), fullscreen=(self)" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <staticContent>
      <!-- Unhashed files (assets/, favicon.ico) are cached for a day; hashed bundles get a year (outbound rule). -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
  <!-- Inbound trace context never reaches a backend: under each backend child application (the paths the SPA fallback
       excludes, except the static Ops screens) the caller's traceparent, tracestate and baggage request headers are
       set to empty, so the API starts its own trace. The list is StrippedRequestHeaders in security-headers.psd1 and
       deploy/nginx/trace-context.conf strips the same headers (parity test). IIS answers 500.50 under these paths
       until HTTP_TRACEPARENT, HTTP_TRACESTATE and HTTP_BAGGAGE are allowed server variables of the site in
       applicationHost.config (see README.md in this folder). The rule only sets variables (action None), so the
       edge block and the SPA fallback inherited from the site root still decide where the request goes. -->
  <location path="api">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="Strip inbound trace context">
            <match url=".*" />
            <serverVariables>
              <set name="HTTP_TRACEPARENT" value="" />
              <set name="HTTP_TRACESTATE" value="" />
              <set name="HTTP_BAGGAGE" value="" />
            </serverVariables>
            <action type="None" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
  <location path="attachments">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="Strip inbound trace context">
            <match url=".*" />
            <serverVariables>
              <set name="HTTP_TRACEPARENT" value="" />
              <set name="HTTP_TRACESTATE" value="" />
              <set name="HTTP_BAGGAGE" value="" />
            </serverVariables>
            <action type="None" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
  <location path="ops-api">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="Strip inbound trace context">
            <match url=".*" />
            <serverVariables>
              <set name="HTTP_TRACEPARENT" value="" />
              <set name="HTTP_TRACESTATE" value="" />
              <set name="HTTP_BAGGAGE" value="" />
            </serverVariables>
            <action type="None" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
  <!-- The runtime settings and the stamped build id change on every deploy without a new URL. -->
  <location path="config.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="build-info.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
