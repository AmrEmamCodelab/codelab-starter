{
  "name": "codelab-starter",
  "private": true,
  "description": "Codelab starter monorepo: Node tooling (rules engine, hooks, extract/scrub, CI checks) and @codelab/* npm package sources.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/npm/*",
    "frontend/starter-web"
  ],
  "scripts": {
    "ci": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1 -Target CI",
    "pack:feed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1 -Pack",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  },
  "devDependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bootstrap-icons": "1.13.2",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "ng-packagr": "22.2.6",
    "rxjs": "7.8.2",
    "sass": "1.107.1",
    "stylelint": "17.16.0",
    "stylelint-use-logical": "2.1.3",
    "svg2ttf": "6.1.0",
    "svgicons2svgfont": "16.0.0",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wawoff2": "2.0.1",
    "yaml": "2.9.1",
    "axe-core": "4.14.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0"
  }
}
