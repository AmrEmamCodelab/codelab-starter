{
  "name": "codelab-starter",
  "private": true,
  "description": "Codelab starter monorepo: Node tooling (rules engine, hooks, extract/scrub, CI checks) and @codelab/* npm package sources.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/npm/*"
  ],
  "scripts": {
    "ci": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1 -Target CI",
    "pack:feed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1 -Pack"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
