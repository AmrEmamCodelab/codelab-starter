registry=https://registry.npmjs.org/
# Exact versions only, and refuse to install on an unsupported Node (see .nvmrc / ADR-005).
save-exact=true
engine-strict=true
fund=false
audit-level=high
# @codelab/* packages: during the monorepo build-out they are linked by npm workspaces.
# Until a hosted registry exists, packed tarballs live in feed/npm and are installed by path, e.g.
#   npm install ./feed/npm/codelab-ng-tools-0.0.1-ci.1.tgz
# When a registry is provisioned, add:  @codelab:registry=<registry url>
