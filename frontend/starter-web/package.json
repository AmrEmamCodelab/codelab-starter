{
  "name": "starter-web",
  "version": "0.0.0",
  "private": true,
  "description": "Starter web app: the Angular 22 frontend of the starter (Arabic-first, RTL, DGA look).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "npm run icons:subset",
    "start": "ng serve --port 4280",
    "prebuild": "npm run icons:subset",
    "build": "ng build",
    "test": "vitest run",
    "lint": "eslint . && stylelint \"src/**/*.{css,scss}\" && node tools/i18n-parity.mjs && node tools/no-inline-styles.mjs && node tools/permission-gates.mjs && node tools/rtl-lint.mjs && node tools/icons-subset.mjs --out src/generated/icons --check",
    "icons:subset": "node tools/icons-subset.mjs --out src/generated/icons",
    "api:gen": "node tools/api-gen/generate.mjs",
    "api:gen:check": "node tools/api-gen/generate.mjs --check",
    "visual": "node e2e/visual.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@codelab/ng-dga": "0.0.0",
    "@codelab/ng-security": "0.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@codelab/ng-tools": "0.5.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss-scss": "4.0.9",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
