<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 3, Access (roles and permissions): the permission catalog in code (the union of every module's
    IPermissionCatalogSource, validated at start and written to the database on every start), the [HasPermission]
    handler over a live per-user resolve (direct grants, assigned roles and virtual roles with organization scope; the
    token carries identity only), the role and grant editor and its self-lockout guard. Layers by namespace (ADR-004):
    .Domain, .Application, .Infrastructure, .Api. User data comes only through the kernel IUserDirectory and
    IAccountAdministration ports, never from the Identity or Users module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Access</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Access.Tests" />
  </ItemGroup>
</Project>
