<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 1, Identity (phase 2 minimum): basic username and password login, one session issuer (JWT access token with
    a sid claim, refresh token rotated with the session version), logout that revokes the sid, idle timeout, and the
    accounts seeded from configuration (break-glass administrator; Development-only users). Layers by namespace
    (ADR-004): .Domain, .Application, .Infrastructure, .Api. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Identity</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>
</Project>
