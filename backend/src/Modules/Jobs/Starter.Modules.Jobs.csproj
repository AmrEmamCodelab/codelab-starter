<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 6b, Background jobs (ADR-004): the job catalog (every IJob a module adds with AddStarterJob), the run history
    (schema jobs, actor SYSTEM), manual "run now" and recurring schedules on Hangfire (SQL Server storage in schema
    hangfire, dashboard never mapped, job server per node behind Jobs:Enabled), and the built-in jobs outbox-drain and
    security-replay-purge. Layers by namespace: .Domain, .Application, .Infrastructure, .Api. It never references
    another module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Jobs</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <!-- Hangfire.Core's transitive Newtonsoft.Json 11.0.1 has a high-severity advisory (NU1903); pinned directly. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Observability" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Jobs.Tests" />
  </ItemGroup>
</Project>
