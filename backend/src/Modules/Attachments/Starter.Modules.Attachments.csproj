<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 13, Attachments (ADR-004): the attachment type catalog (ServiceAttachment) and typed links of uploaded files
    to any record (RecordAttachment) in schema attachments; upload tickets for the browser, receipt-verified links,
    downloads and removals relayed to the separate attachment service over the ES256 service assertion; the
    required-attachments interlock (IRequiredAttachments). Layers by namespace: .Domain, .Application,
    .Infrastructure, .Api. It never references another module; record types plug in through
    Starter.Application.Attachments.IAttachableRecordAccess. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Attachments</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Attachments.Tests" />
  </ItemGroup>
</Project>
