<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 10, Deadlines and SLA timers (ADR-004): one RecordDeadline row per record and status with an SLA (schema
    deadlines), opened and closed by a record transition observer, the deadlines-sla-scan job (every 5 minutes, actor
    SYSTEM) that marks breaches and raises one escalation notification per breach, and the SLA badges of the queue and
    detail views (IRecordSlaReader). Generic: the SLA definitions come from every ISlaPolicySource; it names no record
    type. Layers by namespace: .Domain, .Application, .Infrastructure. It never references another module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Deadlines</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Deadlines.Tests" />
  </ItemGroup>
</Project>
