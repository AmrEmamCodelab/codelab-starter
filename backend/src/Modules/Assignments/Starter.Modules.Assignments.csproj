<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 9, Assignment and queues (ADR-004), created by tools/scaffold/new-module.mjs: the assignment row history
    (schema assignments, one open row per record), the work queue of every record type (gated by the record type's
    queue permission and its organization scope), claim / release / assign, the auto-release on a terminal status and
    the kernel IRecordAssignmentReader. Record facts come only from the kernel IRecordDirectory port. Layers by
    namespace: .Domain, .Application, .Infrastructure, .Api. It never references another module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Assignments</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Assignments.Tests" />
  </ItemGroup>
</Project>
