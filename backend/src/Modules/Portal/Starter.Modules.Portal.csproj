<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 15, Portal (ADR-004): the public portal's backend. Contact us (an anonymous, rate-limited write that stores
    the message under a CU-YYYY-NNN reference number and notifies the configured inbox) and the bilingual content of
    the FAQ, service guide, privacy and terms pages (seeded by migration, read anonymously through a cache, replaced by
    an administrator). Schema portal. Layers by namespace: .Domain, .Application, .Infrastructure, .Api. It never
    references another module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Portal</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Portal.Tests" />
  </ItemGroup>
</Project>
