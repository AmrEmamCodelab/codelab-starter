<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 5, Audit and record history (ADR-004): the audit viewer API over the kernel IAuditTrailQueries port. It has
    no schema of its own: the trail (audit.AuditEntries), the interceptor that writes it and the record history mapping
    live in the kernel (Starter.Infrastructure/Auditing). Layers by namespace: .Application, .Infrastructure, .Api. It
    never references another module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Audit</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Audit.Tests" />
  </ItemGroup>
</Project>
