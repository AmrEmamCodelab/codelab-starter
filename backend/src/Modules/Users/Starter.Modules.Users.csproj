<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 2, Users and organizations (ADR-004), created by tools/scaffold/new-module.mjs: organizations (schema
    users), the user admin endpoints over the kernel IAccountAdministration port (Identity owns the accounts), and the
    Excel import (a minimal xlsx reader on System.IO.Compression + XmlReader, no spreadsheet package) with activation
    tickets and Pending outbox messages instead of any password. Layers by namespace: .Domain, .Application,
    .Infrastructure, .Api. It never references another module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Users</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Users.Tests" />
  </ItemGroup>
</Project>
