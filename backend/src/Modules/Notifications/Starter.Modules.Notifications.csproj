<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module 12, Notifications (ADR-004), an in-process module of the API (no separate notification service): bilingual
    templates seeded by migration (schema notifications), the bell items and feed API, and e-mail and SMS delivery
    through the outbox (IOutboxHandler per channel). Senders: SMTP to the internal relay or .eml files in a pickup
    folder (System.Net.Mail, no mail package); SMS to a JSON-lines file (development) or the integration gateway SMS relay
    (GatewaySmsSender over Codelab.Integration, ES256 service assertion). Layers by namespace: .Domain, .Application, .Infrastructure, .Api. It never references another
    module. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Modules.Notifications</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <CodelabPackageReference Include="Codelab.Security" />
    <CodelabPackageReference Include="Codelab.Errors" />
    <CodelabPackageReference Include="Codelab.Integration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starter.Domain\Starter.Domain.csproj" />
    <ProjectReference Include="..\..\Starter.Application\Starter.Application.csproj" />
    <ProjectReference Include="..\..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Modules.Notifications.Tests" />
  </ItemGroup>
</Project>
