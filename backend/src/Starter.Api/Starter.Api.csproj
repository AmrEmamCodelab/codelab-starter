<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The host (ADR-004). Program.cs wires the Codelab packages and the kernel; the modules come from the ProjectReference
    list below, which is the ONLY place that lists modules: the backend build turns each module reference into a
    ModuleAssemblyAttribute (backend/Directory.Build.targets) and ModuleCatalog discovers them at start. Add or remove a
    module with tools/scaffold/new-module.mjs or tools/remove-module.ps1, never by editing Program.cs. See MODULE.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <CodelabModuleHost>true</CodelabModuleHost>
    <CodelabModuleAttributeType>Starter.Infrastructure.Modularity.ModuleAssemblyAttribute</CodelabModuleAttributeType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Starter.Infrastructure\Starter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Modules">
    <ProjectReference Include="..\Modules\Identity\Starter.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Access\Starter.Modules.Access.csproj" />
    <ProjectReference Include="..\Modules\Users\Starter.Modules.Users.csproj" />
    <ProjectReference Include="..\Modules\Lookups\Starter.Modules.Lookups.csproj" />
    <ProjectReference Include="..\Modules\Audit\Starter.Modules.Audit.csproj" />
    <ProjectReference Include="..\Modules\Settings\Starter.Modules.Settings.csproj" />
    <ProjectReference Include="..\Modules\Jobs\Starter.Modules.Jobs.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Starter.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Portal\Starter.Modules.Portal.csproj" />
  </ItemGroup>
</Project>
