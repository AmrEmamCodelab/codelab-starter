{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "Codelab": {
    "Security": {
      "Protocol": { "Prefix": "STARTER" },
      "RequestSigning": {
        "Mode": "Enforce",
        "Audience": "starter-api",
        "MaxAgeSeconds": 120
      },
      "ResponseSigning": { "Mode": "Enforce" },
      "ReplayProtection": { "Store": "SqlServer" },
      "Sessions": { "Store": "SqlServer" },
      "SqlStore": { "EnsureSchemaOnStart": true }
    }
  },
  "Database": { "ApplyMigrationsOnStartup": false },
  "Features": {},
  "AllowedHosts": "*"
}
