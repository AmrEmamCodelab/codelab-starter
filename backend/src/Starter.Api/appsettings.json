{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "Codelab": {
    "Security": {
      "Protocol": { "Prefix": "STARTER" },
      "RequestSigning": {
        "Mode": "Enforce",
        "Audience": "starter-api",
        "MaxAgeSeconds": 120
      },
      "ResponseSigning": { "Mode": "Enforce" },
      "ReplayProtection": { "Store": "SqlServer" },
      "Sessions": { "Store": "SqlServer" },
      "SqlStore": { "EnsureSchemaOnStart": true }
    }
  },
  "Messaging": { "Outbox": { "Enabled": true, "BatchSize": 50 } },
  "Numbering": { "TimeZoneId": "Arab Standard Time" },
  "Settings": { "CheckStampPerScope": true },
  "Jobs": { "Enabled": true, "WorkerCount": 5, "TimeZoneId": "Arab Standard Time", "PrepareSchemaIfNecessary": true },
  "Notifications": {
    "Email": { "Mode": 2, "FromAddress": "no-reply@example.test", "FromName": "Starter", "Smtp": { "Port": 25, "EnableTls": true, "TimeoutSeconds": 30 } },
    "Sms": { "Enabled": false, "Mode": 1 }
  },
  "Portal": { "Contact": { "InboxEmail": "contact@example.invalid", "InboxLanguage": 1 } },
  "Database": { "ApplyMigrationsOnStartup": false },
  "Features": {},
  "AllowedHosts": "*"
}
