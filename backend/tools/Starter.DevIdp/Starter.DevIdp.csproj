<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The dev IdP: a small OpenID Connect issuer (authorization code + PKCE S256, RS256 id_token, JWKS, userinfo,
    end-session) for local runs (http://localhost:5190) and for tests that host it in process on TestServer. It refuses
    to start outside the Development environment and is never deployed. The RSA signing key is generated in memory at
    start; no key material is stored anywhere. See MODULE.md.

    appsettings.Development.json is an EMBEDDED resource, not a copied file: a test project that references this tool
    and the API host would otherwise get two appsettings.Development.json in its output, and one would overwrite the
    other.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <RootNamespace>Starter.DevIdp</RootNamespace>
    <AssemblyName>Starter.DevIdp</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- TestServer (Microsoft.AspNetCore.TestHost) for DevIdpInProcessServer. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="appsettings*.json" />
    <EmbeddedResource Include="appsettings.Development.json" LogicalName="Starter.DevIdp.appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.DevIdp.Tests" />
  </ItemGroup>
</Project>
