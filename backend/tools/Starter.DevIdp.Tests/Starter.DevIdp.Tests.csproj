<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of Starter.DevIdp: the pure parts (PKCE, the expiring store, options and request validation, client
    authentication, the embedded settings) as unit tests, and the protocol end to end on DevIdpInProcessServer
    (discovery and JWKS shape, authorize validation, the code + PKCE exchange, code reuse and expiry, id_token
    validation against the published JWKS, userinfo, end-session hint and redirect allowlist), plus the refusal to start
    outside Development. A fake clock drives every expiry; no socket and no port is opened.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Starter.DevIdp\Starter.DevIdp.csproj" />
  </ItemGroup>
</Project>
