<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the Access module: the catalog aggregation and its fail-fast refusals, the live resolver, the
    [HasPermission] handler, the grants port, the catalog synchronizer (idempotency, retire, refresh), the use cases,
    the endpoint guards and the module registration. Fakes stand behind the module's repository ports; no database.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Access\Starter.Modules.Access.csproj" />
  </ItemGroup>
</Project>
