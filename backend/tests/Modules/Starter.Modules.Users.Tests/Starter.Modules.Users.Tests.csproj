<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the Users module: the domain rules, every validator and use case (organizations, user admin over a
    fake IAccountAdministration, activation links with a fake IOutbox, import preview and commit), the xlsx reader on
    workbooks built in memory with ZipArchive (header variants, caps, the zip-bomb guard), the options validators and
    the EF model against its InitialCreate migration. No database and no network.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Users\Starter.Modules.Users.csproj" />
  </ItemGroup>
</Project>
