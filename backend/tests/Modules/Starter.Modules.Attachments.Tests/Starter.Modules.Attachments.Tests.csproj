<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the Attachments module: the domain rules (type catalog, typed links, extensions, the required rule,
    the allowlist check), every use case and validator over in-memory fakes of the module ports and the record access
    port (tampered and foreign-scope receipts, idempotent links, max files, extension per type, access denied, the
    interlock, removal with cleanup), on a FakeTimeProvider. No database and no network.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Attachments\Starter.Modules.Attachments.csproj" />
  </ItemGroup>
</Project>
