<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the Identity module: the use cases (login, refresh rotation and reuse, logout), the validators, the
    domain rules, the options validation, token issuance and the bearer revocation check (FakeTimeProvider), account
    seeding (Development users only in Development) and the EF model against its InitialCreate migration. No database
    and no network: the ports are faked in Fakes/.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Identity\Starter.Modules.Identity.csproj" />
  </ItemGroup>
</Project>
