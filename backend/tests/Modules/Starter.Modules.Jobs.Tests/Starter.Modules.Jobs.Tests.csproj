<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the jobs module: the run row's transitions, the catalog, the admin use cases, the runner (system
    actor, correlation and reference codes, overlap, abandoned runs, cancellation), the built-in jobs, the options,
    the registrations, the EF model against its InitialCreate migration, and the Hangfire adapters on Hangfire's
    in-memory storage (queue, recurring schedules, run lock, a manual run end to end through a real job server).
    No database and no network.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Hangfire.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Jobs\Starter.Modules.Jobs.csproj" />
  </ItemGroup>
</Project>
