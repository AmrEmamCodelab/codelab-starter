<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the Settings module: value parsing and validation per type, the domain rules, the runtime reader's
    freshness contract (stamp-change reload, the 30 s TTL with a FakeTimeProvider, two nodes over one fake store), the
    snapshot cache, the admin use cases and validator, the registrations and the EF model against its InitialCreate
    migration (with the seeded settings). No database and no network.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Settings\Starter.Modules.Settings.csproj" />
  </ItemGroup>
</Project>
