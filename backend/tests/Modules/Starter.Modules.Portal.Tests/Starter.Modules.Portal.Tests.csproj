<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of the Portal module: the contact validator, the contact use case (topic check, CU number allocation,
    store-then-notify order, the post-commit notification failure), the content validator and replace (update, add,
    remove, foreign ids, cache invalidation), the cached public read, the memory cache TTL, the options validator, the
    seeded content and the EF model against its InitialCreate migration. Fakes stand behind the module's ports and the
    kernel ports (IRequestNumberAllocator, INotificationService). No database and no network.
  -->
  <PropertyGroup>
    <TargetFramework>$(CodelabTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Portal\Starter.Modules.Portal.csproj" />
  </ItemGroup>
</Project>
